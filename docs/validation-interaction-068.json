    },
    {
      "stage": "initial-collapsed-history-background-timer",
      "classification": "application",
      "status": "fail",
      "detail": "On CI macOS 15 and 26, a throttled initial timer could run after the website opened history. Already-collapsed state is now recorded in the first recognized layout."
    },
    {
      "stage": "keypad-enter-second-image",
      "classification": "application",
      "status": "fail",
      "detail": "All three CI hosts passed 13/14 UI scenarios, but keypad Enter did not produce the second image. AppKit character normalization and bounded offline key/phase diagnostics added; fresh CI required.",
      "resolution": "AppKit Return/Enter normalization and held-key recovery verified in all three final UI rounds on each of the three hosts."
    },
    {
      "stage": "missing-key-up",
      "classification": "application",
      "status": "fail",
      "detail": "A fresh nonrepeat press was rejected after an earlier key-up went to another window. The gate now distinguishes a new press from autorepeat."
    },
    {
      "stage": "resize-grip-first-mouse",
      "classification": "application",
      "status": "fail",
      "detail": "The new NSView grip inherited false for acceptsFirstMouse. It now accepts the initial drag; the packaged scenario also sends the gesture through an independent foreground host and checks that host remains active."
    },
    {
      "stage": "held-return-physical-identity",
      "classification": "application",
      "status": "fail",
      "detail": "Character-first normalization assigned Fn-Return a different identity from the same physical Return key after Fn release. Known physical Return/Enter key codes now take precedence; character fallback is retained for virtual events."
    },
    {
      "stage": "crop-focus-click",
      "classification": "application",
      "status": "fail",
      "detail": "A zero-area focus click discarded an existing crop. It now preserves selected image pixels; only Reset clears the crop and a valid drag replaces it."
    },
    {
      "stage": "automatic-home-click",
      "classification": "application",
      "status": "fail",
      "detail": "Initial collapse could still synthesize a click on website Home for a floating drawer. This action is removed; Home may navigate, so floating website history is left alone."
    },
    {
      "stage": "interactive-view-background-drag",
      "classification": "application",
      "status": "fail",
      "detail": "macOS 27 packaged UI first background-host grip drag resized from 640 to 720 points but moved x from 100 to 178 instead of keeping the top-left fixed. Both nonopaque interactive views inherited mouseDownCanMoveWindow=true. Grip and crop canvas now explicitly return false; native regression failed on both before repair."
    },
    {
      "stage": "macos15-native-sidebar-initial-load",
      "classification": "fixture-under-investigation",
      "status": "fail",
      "run": 44820895960,
      "detail": "Native hydration/restored-open test timed out on macOS 15; packaged UI round 1 passed 14/14. DOM-only fixtures now ignore unrelated physical mouse events and report ready/hydration/expanded state on failure; the original collapse assertion and timing limits remain.",
      "final_verification": "Unchanged behavioral expectations passed after DOM-only input isolation on all final hosts; the original timeout did not include enough state to establish its precise trigger."
    }
